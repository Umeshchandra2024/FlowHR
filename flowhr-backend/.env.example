# Copy to .env and fill in real values. See README.md for details on each variable.

NODE_ENV=development
PORT=4000

# Local dev via docker-compose: postgresql://flowhr:flowhr@localhost:5432/flowhr?schema=public
# Free-tier hosted Postgres (Neon/Supabase/Render): paste the connection string they give you.
DATABASE_URL=postgresql://flowhr:flowhr@localhost:5432/flowhr?schema=public

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173,https://flow-hr-one.vercel.app

# Resend (https://resend.com) free tier. Leave RESEND_API_KEY blank to run with email sending
# fully simulated (safe default) — set EMAIL_SENDING_ENABLED=true only once a real key is set.
RESEND_API_KEY=
EMAIL_FROM=FlowHR <onboarding@resend.dev>
EMAIL_SENDING_ENABLED=false

# Requests allowed per window before 429s kick in.
RUN_RATE_LIMIT_MAX=10
